{
 "uid": "django-orders",
 "title": "Django Orders - RED/USE",
 "tags": [
  "django",
  "orders"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "namespace",
    "type": "constant",
    "query": "demo",
    "hide": 2,
    "current": {
     "value": "demo",
     "text": "demo"
    }
   },
   {
    "name": "release",
    "type": "constant",
    "query": "orders",
    "hide": 2,
    "current": {
     "value": "orders",
     "text": "orders"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request rate (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(django_http_requests_total_by_method_total{namespace=\"$namespace\"}[1m]))",
     "legendFormat": "total",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (method)(rate(django_http_requests_total_by_method_total{namespace=\"$namespace\"}[1m]))",
     "legendFormat": "{{method}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "description": "RED: Rate"
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "5xx error ratio (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(django_http_responses_total_by_status_total{namespace=\"$namespace\",status=~\"5..\"}[2m])) / sum(rate(django_http_responses_total_by_status_total{namespace=\"$namespace\"}[2m]))",
     "legendFormat": "5xx %",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "description": "RED: Errors"
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le)(rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"$namespace\"}[5m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.50, sum by (le)(rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"$namespace\"}[5m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "description": "RED: Duration"
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Responses by status (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status)(rate(django_http_responses_total_by_status_total{namespace=\"$namespace\"}[1m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Pod CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",pod=~\"$release-.*\"}[2m]))",
     "legendFormat": "{{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "description": "USE: Utilisation"
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Pod memory working set",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod)(container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",pod=~\"$release-.*\"})",
     "legendFormat": "{{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "description": "USE: Utilisation"
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Container restarts",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod)(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"$release-.*\"})",
     "legendFormat": "{{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "description": "USE: Errors"
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Ready replicas by deployment",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=~\"$release-.*\"}",
     "legendFormat": "{{deployment}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "logs",
   "title": "Logs (Loki) - web container, JSON parsed",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"$namespace\", container=\"web\"} | json",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "enableLogDetails": true,
    "sortOrder": "Descending",
    "wrapLogMessage": true
   }
  }
 ]
}