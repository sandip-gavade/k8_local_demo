# Rendered by the nginx image's envsubst entrypoint. Only ${API_UPSTREAM} is substituted.
server {
  listen 8080;
  root /usr/share/nginx/html;
  location /api/ { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; }  # compose only; K8s Ingress routes /api itself
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { try_files $uri /index.html; }
}
